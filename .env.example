# ==============================================================================
# VASTRA BY VARUN 2.0 - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_URL="https://vastra.pages.dev"
NEXT_PUBLIC_APP_NAME="Vastra by Varun 2.0"
NEXT_PUBLIC_API_BASE_URL="https://vastra.pages.dev/api"

# Cloudflare Configuration & Secrets
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"
CLOUDFLARE_D1_DATABASE_ID="your_d1_database_id_here"
CLOUDFLARE_R2_BUCKET_NAME="vastra-media-prod"
CLOUDFLARE_R2_PUBLIC_URL="https://media.vastra.com"

# Authentication Secrets (Better Auth)
BETTER_AUTH_SECRET="your_32_character_random_auth_secret_here"
BETTER_AUTH_URL="https://vastra.pages.dev"

# Payment Gateway - Razorpay Integration
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Transactional Email - Resend Integration
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM_ADDRESS="orders@vastra.com"
EMAIL_SUPPORT_ADDRESS="support@vastra.com"

# Security & Encryption
ENCRYPTION_SECRET="your_secure_encryption_key_32_bytes"
JWT_SECRET="your_jwt_signing_secret_here"

# Logging & Monitoring
LOG_LEVEL="info" # debug | info | warn | error
ENABLE_AUDIT_LOGS="true"
