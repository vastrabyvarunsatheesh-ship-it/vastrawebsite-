{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vastra-by-varun",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vastra_db_prod",
      "database_id": "PLACEHOLDER_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "vastra-media-prod"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "PLACEHOLDER_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Vastra by Varun 2.0"
  }
}
