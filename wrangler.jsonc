{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vastrawebsite",
  "pages_build_output_dir": "out",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vastra_db_prod",
      "database_id": "63ee77dc-8502-4518-8756-9f7847b217b1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "vastra-media-prod"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Vastra by Varun 2.0"
  }
}
